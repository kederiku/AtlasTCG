# Local only. Compose reads POSTGRES_*; never commit the real .env.
POSTGRES_DB=tcg
POSTGRES_USER=tcg
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
# Host development only; containers build their URL with the internal host postgres.
# Encode reserved characters in the password when writing this URL.
TCG_DATABASE_URL=postgresql+psycopg://tcg:change-this-local-password@127.0.0.1:5432/tcg

# Set these to the output of `id -u` and `id -g` for writable bind mounts.
TCG_UID=1000
TCG_GID=1000
TCG_DATA_DIR=./data
# Optional collector identity/contact, shared by Docker services.
TCG_USER_AGENT=TCGCatalog/0.1
